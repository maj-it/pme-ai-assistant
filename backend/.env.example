# Fournisseur d'IA : auto (Ollama s'il répond, sinon Anthropic si clé, sinon démo hors ligne) | ollama | anthropic | offline
LLM_PROVIDER=auto

# Ollama local (WSL / Docker). Modèle vide = détection automatique (qwen en priorité ; il doit gérer les outils : qwen2.5, qwen3, llama3.1)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Anthropic (à activer plus tard) : clé du workspace "Default"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Protection de la démo
DEMO_TOKEN=
RATE_PER_HOUR=40
ALLOWED_ORIGINS=*
